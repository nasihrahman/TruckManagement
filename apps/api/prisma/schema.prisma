generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id           String         @id @default(cuid())
  name         String
  createdAt    DateTime       @default(now())
  users        User[]
  trucks       Truck[]
  trips        Trip[]
  documents    Document[]
  fuelReceipts FuelReceipt[]
  expenses     Expense[]
  maintenance  MaintenanceRecord[]
  issues       Issue[]
  notifications Notification[]
  driverShifts DriverShift[]
  locationPings LocationPing[]
  materials    Material[]
  suppliers    Supplier[]
  hitachiJobs  HitachiJob[]
}

model User {
  id                      String   @id @default(cuid())
  company                 Company  @relation(fields: [companyId], references: [id])
  companyId               String
  email                   String?  @unique
  password                String
  currentHashedRefreshToken String?
  role                    Role
  firstName               String?
  lastName                String?
  phone                   String   @unique
  isActive                Boolean  @default(true)
  mustChangePassword      Boolean  @default(false)
  createdAt               DateTime @default(now())
  defaultTruck            Truck?   @relation(fields: [defaultTruckId], references: [id])
  defaultTruckId          String?
  trips                   Trip[]
  driverProfile           DriverProfile?
  driverShifts            DriverShift[]
  locationPings           LocationPing[]
  expenses                Expense[]
  hitachiJobs             HitachiJob[]
}

model DriverProfile {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String   @unique
  licenseNumber String?
  updatedAt     DateTime @updatedAt
}

enum Role {
  OWNER
  DRIVER
}

model Truck {
  id             String              @id @default(cuid())
  company        Company             @relation(fields: [companyId], references: [id])
  companyId      String
  plate          String              @unique
  brand          String?
  vin            String?
  createdAt      DateTime            @default(now())
  maintenance    MaintenanceRecord[]
  trips          Trip[]
  defaultForDrivers User[]
  hitachiJobs    HitachiJob[]
}

model Material {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  name      String
  createdAt DateTime @default(now())
  trips     Trip[]

  @@unique([companyId, name])
}

model Supplier {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  name      String
  createdAt DateTime @default(now())
  trips     Trip[]

  @@unique([companyId, name])
}

model HitachiJob {
  id                String        @id @default(cuid())
  company           Company       @relation(fields: [companyId], references: [id])
  companyId         String
  driver            User          @relation(fields: [driverId], references: [id])
  driverId          String
  truck             Truck?        @relation(fields: [truckId], references: [id])
  truckId           String?
  date              DateTime
  customerName      String?
  place             String?
  totalHours        Decimal?      @db.Decimal(10, 2)
  paymentReceived   Decimal?      @db.Decimal(10, 2)
  paymentReceivedBy HitachiPayer?
  nDieselExpense    Decimal?      @db.Decimal(10, 2)
  nDieselPaidBy     HitachiPayer?
  hDieselExpense    Decimal?      @db.Decimal(10, 2)
  hDieselPaidBy     HitachiPayer?
  opBata            Decimal?      @db.Decimal(10, 2)
  opBataPaidBy      HitachiPayer?
  otherExpenseM     Decimal?      @db.Decimal(10, 2)
  otherExpenseJ     Decimal?      @db.Decimal(10, 2)
  salaryAdvance     Decimal?      @db.Decimal(10, 2)
  photoUrl          String?
  createdAt         DateTime      @default(now())
}

enum HitachiPayer {
  M
  J
}

model Trip {
  id            String        @id @default(cuid())
  company       Company       @relation(fields: [companyId], references: [id])
  companyId     String
  truck         Truck?        @relation(fields: [truckId], references: [id])
  truckId       String?
  driver        User?         @relation(fields: [driverId], references: [id])
  driverId      String?
  status        TripStatus    @default(ASSIGNED)
  freightAmount Decimal?      @db.Decimal(10,2)
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  financiallyClosed Boolean   @default(false)
  createdAt     DateTime      @default(now())
  material      Material?     @relation(fields: [materialId], references: [id])
  materialId    String?
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  supplierId    String?
  qtyCf         Decimal?      @db.Decimal(10,2)
  customerName  String?
  fuelReceipts  FuelReceipt[]
  expenses      Expense[]
  issues        Issue[]
  locationPings LocationPing[]
}

enum TripStatus {
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  FAILED
}

model FuelReceipt {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  trip      Trip?    @relation(fields: [tripId], references: [id])
  tripId    String?
  amount    Decimal  @db.Decimal(10,2)
  photoUrl  String?
  createdAt DateTime @default(now())
}

model Expense {
  id        String          @id @default(cuid())
  company   Company         @relation(fields: [companyId], references: [id])
  companyId String
  trip      Trip            @relation(fields: [tripId], references: [id])
  tripId    String
  driver    User            @relation(fields: [driverId], references: [id])
  driverId  String
  category  ExpenseCategory
  amount    Decimal         @db.Decimal(10, 2)
  photoUrl  String?
  odometer  Int?
  reason    String?
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

enum ExpenseCategory {
  FUEL
  FINE
  OTHER
}

model MaintenanceRecord {
  id          String   @id @default(cuid())
  company     Company  @relation(fields: [companyId], references: [id])
  companyId   String
  truck       Truck    @relation(fields: [truckId], references: [id])
  truckId     String
  type        String
  cost        Decimal  @db.Decimal(10,2)
  date        DateTime
  nextDueDate DateTime?
  createdAt   DateTime @default(now())
}

model Document {
  id        String    @id @default(cuid())
  company   Company   @relation(fields: [companyId], references: [id])
  companyId String
  ownerId   String?
  ownerType String?
  fileUrl   String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model Issue {
  id          String   @id @default(cuid())
  company     Company  @relation(fields: [companyId], references: [id])
  companyId   String
  trip        Trip?    @relation(fields: [tripId], references: [id])
  tripId      String?
  reportedBy  String?
  type        String
  description String
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  userId    String?
  title     String
  body      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model DriverShift {
  id        String   @id @default(cuid())
  driver    User     @relation(fields: [driverId], references: [id])
  driverId  String
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  startedAt DateTime @default(now())
  endedAt   DateTime?
  date      DateTime @default(now())
}

/// One row per driver holding their CURRENT location, not a history of pings.
/// Nothing in the app ever read older pings — only the newest — so the 60s
/// ping loop now updates this row in place instead of inserting ~600 rows per
/// driver per day. Keeps the table at one row per driver permanently.
/// If route replay or distance-travelled is ever needed, that wants a separate
/// history table starting from that day; this one cannot reconstruct the past.
model LocationPing {
  id        String   @id @default(cuid())
  driver    User     @relation(fields: [driverId], references: [id])
  driverId  String   @unique
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  trip      Trip?    @relation(fields: [tripId], references: [id])
  tripId    String?
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  /// When this driver was last heard from — this is the timestamp the Owner
  /// dashboard's "Xm ago" is derived from, not createdAt.
  updatedAt DateTime @updatedAt
}